# Set to TRUE only if you agree to https://www.minecraft.net/eula
EULA=FALSE
MC_VERSION=1.20.1
MOD_LOADER=FORGE
FORGE_VERSION=47.3.0
JAVA_TAG=java17
MEMORY=4G
# Set these to the output of id -u and id -g.
MC_UID=1000
MC_GID=1000

# Minecraft port (also used by apply-firewall.sh). Changing it: see README.
PORT=25565
# TRUE verifies players against Mojang's servers. FALSE allows cracked/offline
# clients and lets anyone use any username, so only use it on a closed network.
ONLINE_MODE=TRUE
# How many backups ./backup.sh keeps.
BACKUP_KEEP=7
